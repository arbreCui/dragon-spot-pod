****************************************************************
* SpotAsmR64.c2m -- assemble one projected SPOD archive        *
*                                                              *
* This candidate procedure is not selected by a shipped deck.  *
* It performs three fresh host ASM calls and no radial solve.   *
****************************************************************
PARAMETER ASSEMBLED PROJECTED TRACK_f ::
  ::: LINKED_LIST ASSEMBLED PROJECTED ;
  ::: SEQ_BINARY TRACK_f ; ;

LINKED_LIST MICROLIB2 MACRO0 TRACK SYSTEM1 SYSTEM2 SYSTEM3 ;
MODULE RECOVER: ASM: SPOR64K: DELETE: END: ;

MICROLIB2 := RECOVER: PROJECTED :: ITEM 1 ;
MACRO0 := MICROLIB2 ;
MICROLIB2 := DELETE: MICROLIB2 ;
TRACK := RECOVER: PROJECTED :: ITEM 1 ;
SYSTEM1 := ASM: MACRO0 TRACK TRACK_f PROJECTED ::
  EDIT 0 ARM LK1D 1 ;
MACRO0 TRACK := DELETE: MACRO0 TRACK ;

MICROLIB2 := RECOVER: PROJECTED :: ITEM 2 ;
MACRO0 := MICROLIB2 ;
MICROLIB2 := DELETE: MICROLIB2 ;
TRACK := RECOVER: PROJECTED :: ITEM 2 ;
SYSTEM2 := ASM: MACRO0 TRACK TRACK_f PROJECTED ::
  EDIT 0 ARM LK1D 2 ;
MACRO0 TRACK := DELETE: MACRO0 TRACK ;

MICROLIB2 := RECOVER: PROJECTED :: ITEM 3 ;
MACRO0 := MICROLIB2 ;
MICROLIB2 := DELETE: MICROLIB2 ;
TRACK := RECOVER: PROJECTED :: ITEM 3 ;
SYSTEM3 := ASM: MACRO0 TRACK TRACK_f PROJECTED ::
  EDIT 0 ARM LK1D 3 ;
MACRO0 TRACK := DELETE: MACRO0 TRACK ;

ASSEMBLED := SPOR64K: PROJECTED SYSTEM1 SYSTEM2 SYSTEM3 :: ;
SYSTEM1 SYSTEM2 SYSTEM3 := DELETE: SYSTEM1 SYSTEM2 SYSTEM3 ;

END: ;
