****************************************************************
* SpotStepR64.c2m -- one owned projected-to-returned step      *
*                                                              *
* This procedure is not selected by a shipped calculation.     *
* Explicit selection performs three fresh ASM calls and then   *
* gives their still-live SYSTEM objects directly to SPOR64T.    *
****************************************************************
PARAMETER RETURNED PROJECTED TRACK_f ::
  ::: LINKED_LIST RETURNED PROJECTED ;
  ::: SEQ_BINARY TRACK_f ; ;

LINKED_LIST MICROLIB2 MACRO0 TRACK SYSTEM1 SYSTEM2 SYSTEM3 ;
MODULE RECOVER: ASM: SPOR64T: DELETE: END: ;

MICROLIB2 := RECOVER: PROJECTED :: ITEM 1 ;
MACRO0 := MICROLIB2 ;
MICROLIB2 := DELETE: MICROLIB2 ;
TRACK := RECOVER: PROJECTED :: ITEM 1 ;
SYSTEM1 := ASM: MACRO0 TRACK TRACK_f PROJECTED ::
  EDIT 0 ARM LK1D 1 ;
MACRO0 TRACK := DELETE: MACRO0 TRACK ;

MICROLIB2 := RECOVER: PROJECTED :: ITEM 2 ;
MACRO0 := MICROLIB2 ;
MICROLIB2 := DELETE: MICROLIB2 ;
TRACK := RECOVER: PROJECTED :: ITEM 2 ;
SYSTEM2 := ASM: MACRO0 TRACK TRACK_f PROJECTED ::
  EDIT 0 ARM LK1D 2 ;
MACRO0 TRACK := DELETE: MACRO0 TRACK ;

MICROLIB2 := RECOVER: PROJECTED :: ITEM 3 ;
MACRO0 := MICROLIB2 ;
MICROLIB2 := DELETE: MICROLIB2 ;
TRACK := RECOVER: PROJECTED :: ITEM 3 ;
SYSTEM3 := ASM: MACRO0 TRACK TRACK_f PROJECTED ::
  EDIT 0 ARM LK1D 3 ;
MACRO0 TRACK := DELETE: MACRO0 TRACK ;

RETURNED := SPOR64T: PROJECTED SYSTEM1 SYSTEM2 SYSTEM3 TRACK_f :: ;
SYSTEM1 SYSTEM2 SYSTEM3 := DELETE: SYSTEM1 SYSTEM2 SYSTEM3 ;

END: ;
