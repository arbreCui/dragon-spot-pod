****************************************************************
* B2l: exactly one real plane-1 ASM response build.             *
*                                                              *
* No FLU, source construction, CONT, loop, or outer iteration.  *
****************************************************************

SEQ_BINARY TRACK_f :: FILE './initial_radial_track.bin' ;
XSM_FILE PROJECTED :: FILE './projected.xsm' ;
XSM_FILE SYSTEM_OUT :: FILE './system1.xsm' ;

LINKED_LIST MICROLIB2 MACRO0 TRACK SYSTEM ;
MODULE RECOVER: ASM: DELETE: END: ;

ECHO "B2L-ONE-PLANE-REAL-ASM-BEGIN" ;

MICROLIB2 := RECOVER: PROJECTED :: ITEM 1 ;
MACRO0 := MICROLIB2 ;
MICROLIB2 := DELETE: MICROLIB2 ;
TRACK := RECOVER: PROJECTED :: ITEM 1 ;

SYSTEM := ASM: MACRO0 TRACK TRACK_f PROJECTED ::
  EDIT 0 ARM LK1D 1 ;

SYSTEM_OUT := SYSTEM ;
MACRO0 TRACK SYSTEM := DELETE: MACRO0 TRACK SYSTEM ;

ECHO "B2L-ONE-PLANE-REAL-ASM-COMPLETE" ;
END: ;
QUIT "LIST" .
