****************************************************************
* One direct continuation, radial half: x1 -> radial response. *
****************************************************************

SEQ_BINARY TRACK_f :: FILE './initial_radial_track.bin' ;

XSM_FILE SNAP1_ARCH :: FILE './state1_snapshots.xsm' ;
XSM_FILE TRACK_AX :: FILE './initial_axial_track.xsm' ;
XSM_FILE MACROLIB3 :: FILE './initial_axial_macrolib.xsm' ;
XSM_FILE BASIS_REF :: FILE './basis_reference.xsm' ;
XSM_FILE AX1_ARCH :: FILE './state1_axial.xsm' ;

XSM_FILE SYSTEM_OUT :: FILE './state2_system.xsm' ;
XSM_FILE RADIAL_OUT :: FILE './state2_radial.xsm' ;

LINKED_LIST SNAP TRACK SYSTEM_NEXT ;
MODULE RECOVER: ASM: SPOPROJ: GREP: END: ;
PROCEDURE SpotRefFS ;

INTEGER spod_rank := 1 ;
REAL solver_eps := 5.0E-7 ;
REAL k1 ;
INTEGER fixed_marker fs_count ;
DOUBLE rbal source_l2 source_max ;

ECHO "MAP2-RADIAL-BEGIN" ;
ECHO "MAP2-RADIAL-TOLERANCE" solver_eps ;

* SNAP1_ARCH already contains the direct L1 return from the accepted map.
SNAP := SNAP1_ARCH ;
TRACK := RECOVER: SNAP :: ITEM 3 ;
GREP: AX1_ARCH :: GETVAL 'K-EFFECTIVE' 1 >>k1<< ;

* Reconstruct B*a1 and solve all three frozen-fission radial equations.
SNAP := SPOPROJ: SNAP AX1_ARCH TRACK_AX :: FIXB ;
SNAP := SpotRefFS SNAP TRACK TRACK_f ::
  <<k1>> <<solver_eps>> ;

* Preserve B and rebuild only the response generated from x1.
SYSTEM_NEXT := ASM: MACROLIB3 TRACK_AX SNAP BASIS_REF ::
  EDIT 0 SPOD <<spod_rank>> FIXB ;
GREP: SYSTEM_NEXT ::
  GETVAL 'SPOT-FIXB' 1 >>fixed_marker<<
  GETVAL 'SPOT-FS-N' 1 >>fs_count<<
  GETVAL 'SPOT-RBAL' 1 >>rbal<<
  GETVAL 'SPOT-Q-L2' 1 >>source_l2<<
  GETVAL 'SPOT-Q-MAX' 1 >>source_max<< ;
ECHO "MAP2-RADIAL-CONTRACT"
  fixed_marker fs_count rbal source_l2 source_max ;

SYSTEM_OUT := SYSTEM_NEXT ;
RADIAL_OUT := SNAP ;

ECHO "MAP2-RADIAL-COMPLETE" ;
END: ;
QUIT "LIST" .
