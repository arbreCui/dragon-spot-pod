diff --git a/src/SPOMGMR.f90 b/src/SPOMGMR.f90
new file mode 100644
index 0000000000000000000000000000000000000000..a7c732ac29cc34f3001c1a87e454565481440af0
--- /dev/null
+++ b/src/SPOMGMR.f90
@@ -0,0 +1,624 @@
+module SPOMGMR_AUDIT
+  use, intrinsic :: iso_c_binding, only: c_ptr, c_null_ptr, c_associated
+  use, intrinsic :: iso_fortran_env, only: int32, real32
+  use GANLIB
+  implicit none
+  private
+
+  integer, parameter :: schema_version = 1
+  integer, parameter :: required_groups = 370
+  integer, parameter :: required_unknowns = 14
+  integer, parameter :: required_regions = 8
+  integer, parameter :: required_maxi = 20
+  integer, parameter :: required_nstart = 10
+  integer, parameter :: required_role_capacity = required_maxi
+  integer, parameter :: required_block_capacity = required_maxi - 1
+  integer(int32), parameter :: required_flu_epsilon_bits = &
+       int(z'348637BD', int32)
+  integer(int32), parameter :: required_errtol_bits = &
+       int(z'3727C5AC', int32)
+
+  type(c_ptr), save :: audit_root = c_null_ptr
+  logical, save :: requested = .false.
+  logical, save :: armed = .false.
+  logical, save :: complete = .false.
+  logical, save :: call_open = .false.
+  logical, save :: block_open = .false.
+  integer, save :: state_vector(24) = 0
+  integer, save :: ngind_ledger(required_groups) = 0
+  integer, save :: role_calls(3) = 0
+  integer, save :: role_groups(3) = 0
+  integer, save :: k_histogram(0:required_nstart) = 0
+  integer, save :: entry_count = 0
+  integer, save :: exit_count = 0
+  integer, save :: role_event_count = 0
+  integer, save :: correction_block_count = 0
+  integer, save :: current_call = 0
+  integer, save :: current_block = 0
+  integer, save :: nonzero_k_group_block_count = 0
+  integer, save :: sum_k = 0
+  integer, save :: max_k = 0
+  integer, allocatable, save :: call_meta(:,:)
+  integer, allocatable, save :: role_events(:,:)
+  integer, allocatable, save :: role_active(:,:)
+  integer, allocatable, save :: block_meta(:,:)
+  integer, allocatable, save :: block_active(:,:)
+  integer, allocatable, save :: block_kmax(:,:)
+
+  public :: SPOMGMR_FLU_RESET
+  public :: SPOMGMR_PARSE_GMRA
+  public :: SPOMGMR_REQUIRE_MOCA
+  public :: SPOMGMR_BEGIN
+  public :: SPOMGMR_MCGMRE_ENTER
+  public :: SPOMGMR_ROLE
+  public :: SPOMGMR_BLOCK_BEGIN
+  public :: SPOMGMR_BLOCK_END
+  public :: SPOMGMR_MCGMRE_EXIT
+  public :: SPOMGMR_FINISH
+
+contains
+
+  logical function activity_active()
+    activity_active = requested .and. armed .and. (.not. complete)
+  end function activity_active
+
+
+  subroutine SPOMGMR_FLU_RESET()
+    if (armed .or. call_open .or. block_open) &
+         call fail('unfinished state at FLU entry')
+    call release_memory()
+    requested = .false.
+    complete = .false.
+  end subroutine SPOMGMR_FLU_RESET
+
+
+  subroutine SPOMGMR_PARSE_GMRA()
+    if (requested) call fail('duplicate GMRA keyword')
+    if (armed) call fail('GMRA parsed after audit begin')
+    requested = .true.
+  end subroutine SPOMGMR_PARSE_GMRA
+
+
+  subroutine SPOMGMR_REQUIRE_MOCA(moca_arm)
+    integer, intent(in) :: moca_arm
+
+    if (.not. requested) return
+    if (moca_arm /= 2) call fail('GMRA requires MOCA 2')
+  end subroutine SPOMGMR_REQUIRE_MOCA
+
+
+  subroutine SPOMGMR_BEGIN(ipflux, iptrk, moca_arm, cxdoor, itypec, &
+       ngrp, nun, nreg, maxout, maxinr, epsout, epsunk, epsinr, &
+       lforw, ileak, lrebal, initfl, ncptl, ncpta)
+    type(c_ptr), intent(in) :: ipflux, iptrk
+    integer, intent(in) :: moca_arm, itypec, ngrp, nun, nreg
+    integer, intent(in) :: maxout, maxinr, ileak, initfl, ncptl, ncpta
+    real(real32), intent(in) :: epsout, epsunk, epsinr
+    logical, intent(in) :: lforw, lrebal
+    character(len=*), intent(in) :: cxdoor
+    integer :: ilong, itype
+    integer :: mccg_state(40)
+    real(real32) :: real_param(4)
+
+    if (.not. requested) return
+    if (armed) call fail('nested or repeated BEGIN')
+    if (moca_arm /= 2) call fail('MOCA arm 2 required')
+    if (.not. c_associated(ipflux)) call fail('missing L_FLUX owner')
+    if (.not. c_associated(iptrk)) call fail('missing L_TRACK source')
+    if (trim(cxdoor) /= 'MCCG') call fail('MCCG door required')
+    if (itypec /= 0) call fail('TYPE S required')
+    if (ngrp /= required_groups) call fail('370 groups required')
+    if (nun /= required_unknowns) call fail('14 unknowns required')
+    if (nreg /= required_regions) call fail('8 regions required')
+    if (maxout /= 1) call fail('MAXOUT=1 required')
+    if (maxinr /= 740) call fail('MAXINR=740 required')
+    if (transfer(epsout, 0_int32) /= required_flu_epsilon_bits) &
+         call fail('EPSOUT bits differ')
+    if (transfer(epsunk, 0_int32) /= required_flu_epsilon_bits) &
+         call fail('EPSUNK bits differ')
+    if (transfer(epsinr, 0_int32) /= required_flu_epsilon_bits) &
+         call fail('EPSINR bits differ')
+    if (.not. lforw) call fail('direct solve required')
+    if (ileak /= 0) call fail('ILEAK=0 required')
+    if (.not. lrebal) call fail('rebalancing must be active')
+    if (initfl /= 1) call fail('INIT ON required')
+    if ((ncptl /= 1) .or. (ncpta /= 0)) &
+         call fail('ACCE 1 0 required')
+
+    call LCMLEN(iptrk, 'MCCG-STATE', ilong, itype)
+    if ((ilong /= 40) .or. (itype /= 1)) &
+         call fail('invalid MCCG-STATE record')
+    call LCMGET(iptrk, 'MCCG-STATE', mccg_state)
+    if (mccg_state(3) /= required_nstart) call fail('KRYL=10 required')
+    if (mccg_state(4) /= 0) call fail('IDIFC=0 required')
+    if (mccg_state(7) /= 80) call fail('IAAC=80 required')
+    if (mccg_state(8) /= 0) call fail('ISCR=0 required')
+    if (mccg_state(10) /= 4) call fail('PACA=4 required')
+    if (mccg_state(13) /= required_maxi) call fail('MAXI=20 required')
+    if (mccg_state(15) /= 1) call fail('STIS=1 required')
+    if (mccg_state(18) /= 0) call fail('direct MCCG state required')
+
+    call LCMLEN(iptrk, 'REAL-PARAM', ilong, itype)
+    if ((ilong /= 4) .or. (itype /= 2)) &
+         call fail('invalid REAL-PARAM record')
+    call LCMGET(iptrk, 'REAL-PARAM', real_param)
+    if (transfer(real_param(1), 0_int32) /= required_errtol_bits) &
+         call fail('TRACK ERRTOL bits differ')
+
+    call LCMLEN(ipflux, 'SPOT-GMR-AUD', ilong, itype)
+    if (ilong /= 0) call fail('audit directory already exists')
+
+    allocate(call_meta(5, 1))
+    allocate(role_events(6, required_role_capacity))
+    allocate(role_active(required_groups, required_role_capacity))
+    allocate(block_meta(4, required_block_capacity))
+    allocate(block_active(required_groups, required_block_capacity))
+    allocate(block_kmax(required_groups, required_block_capacity))
+    call_meta = 0
+    role_events = 0
+    role_active = 0
+    block_meta = 0
+    block_active = 0
+    block_kmax = 0
+    state_vector = 0
+    ngind_ledger = 0
+    role_calls = 0
+    role_groups = 0
+    k_histogram = 0
+    entry_count = 0
+    exit_count = 0
+    role_event_count = 0
+    correction_block_count = 0
+    current_call = 0
+    current_block = 0
+    nonzero_k_group_block_count = 0
+    sum_k = 0
+    max_k = 0
+    call_open = .false.
+    block_open = .false.
+    complete = .false.
+
+    audit_root = LCMDID(ipflux, 'SPOT-GMR-AUD')
+    if (.not. c_associated(audit_root)) call fail('cannot create sink')
+    armed = .true.
+    state_vector(1) = schema_version
+    state_vector(2) = 0
+    state_vector(3) = moca_arm
+    state_vector(4) = 1
+    state_vector(5) = ngrp
+    state_vector(6) = nun
+    state_vector(7) = 0
+    state_vector(8) = required_nstart
+    state_vector(21) = required_maxi
+    state_vector(22) = int(required_errtol_bits, kind(state_vector))
+    state_vector(23) = 0
+    state_vector(24) = 0
+    call LCMPUT(audit_root, 'STATE-VECTOR', 24, 1, state_vector)
+  end subroutine SPOMGMR_BEGIN
+
+
+  subroutine SPOMGMR_MCGMRE_ENTER(maxi, errtol, nstart, ngroup, &
+       ngeff, ngind, nun, ndim, nlong, nreg, nsout, nani, nlin, &
+       nfunl, iaac, iscr, paca, stis, idir, cyclic, lforw)
+    integer, intent(in) :: maxi, nstart, ngroup, ngeff, nun, ndim
+    integer, intent(in) :: nlong, nreg, nsout, nani, nlin, nfunl
+    integer, intent(in) :: iaac, iscr, paca, stis, idir
+    integer, intent(in) :: ngind(ngeff)
+    real(real32), intent(in) :: errtol
+    logical, intent(in) :: cyclic, lforw
+    integer :: i
+
+    if (.not. activity_active()) return
+    if (entry_count /= 0) call fail('second MCGMRE entry')
+    if (call_open) call fail('nested MCGMRE entry')
+    if (maxi /= required_maxi) call fail('actual MAXI differs')
+    if (transfer(errtol, 0_int32) /= required_errtol_bits) &
+         call fail('actual ERRTOL bits differ')
+    if (nstart /= required_nstart) call fail('actual NSTART differs')
+    if (ngroup /= required_groups) call fail('actual NGROUP differs')
+    if (ngeff /= required_groups) call fail('actual NGEFF differs')
+    if (nun /= required_unknowns) call fail('actual NUN differs')
+    if (ndim /= 2) call fail('actual NDIM differs')
+    if (nlong /= required_unknowns) call fail('actual NLONG differs')
+    if (nreg /= required_regions) call fail('actual NREG differs')
+    if (nsout /= 6) call fail('actual NSOUT differs')
+    if (nani /= 1) call fail('actual NANI differs')
+    if ((nlin /= 1) .or. (nfunl /= 1)) &
+         call fail('actual NLIN or NFUNL differs')
+    if (iaac /= 80) call fail('actual IAAC differs')
+    if (iscr /= 0) call fail('actual ISCR differs')
+    if (paca /= 4) call fail('actual PACA differs')
+    if (stis /= 1) call fail('actual STIS differs')
+    if (idir /= 0) call fail('actual IDIR differs')
+    if (cyclic) call fail('actual tracking must be non-cyclic')
+    if (.not. lforw) call fail('actual solve must be direct')
+    do i = 1, required_groups
+      if (ngind(i) /= i) call fail('actual NGIND must equal 1..370')
+    end do
+
+    entry_count = 1
+    current_call = 1
+    call_open = .true.
+    ngind_ledger = ngind
+    call_meta(:, 1) = 0
+    call_meta(1, 1) = 1
+    state_vector(7) = ngeff
+  end subroutine SPOMGMR_MCGMRE_ENTER
+
+
+  subroutine SPOMGMR_ROLE(role, iteration, ngeff, nconv)
+    integer, intent(in) :: role, iteration, ngeff
+    logical, intent(in) :: nconv(ngeff)
+    integer :: active_count, block_index, event_index, i
+
+    if (.not. activity_active()) return
+    if (.not. call_open) call fail('role outside MCGMRE call')
+    if ((role < 1) .or. (role > 3)) call fail('invalid role')
+    if (iteration < 1) call fail('invalid role ITER')
+    if (ngeff /= required_groups) call fail('role NGEFF differs')
+    if (role_event_count >= required_role_capacity) &
+         call fail('role-event capacity exceeded')
+    if (role == 1) then
+      if (block_open) call fail('PRIMARY inside correction block')
+      block_index = 0
+    else
+      if (.not. block_open) call fail('block role outside block')
+      block_index = current_block
+    end if
+    if (role_event_count > 0) then
+      if (iteration < role_events(4, role_event_count)) &
+           call fail('role ITER decreased')
+    end if
+
+    role_event_count = role_event_count + 1
+    event_index = call_meta(3, current_call) + 1
+    active_count = count(nconv)
+    role_events(1, role_event_count) = current_call
+    role_events(2, role_event_count) = event_index
+    role_events(3, role_event_count) = role
+    role_events(4, role_event_count) = iteration
+    role_events(5, role_event_count) = block_index
+    role_events(6, role_event_count) = active_count
+    do i = 1, required_groups
+      if (nconv(i)) role_active(i, role_event_count) = 1
+    end do
+    role_calls(role) = role_calls(role) + 1
+    role_groups(role) = role_groups(role) + active_count
+    call_meta(3, current_call) = event_index
+  end subroutine SPOMGMR_ROLE
+
+
+  subroutine SPOMGMR_BLOCK_BEGIN(iteration, ngeff, nconv)
+    integer, intent(in) :: iteration, ngeff
+    logical, intent(in) :: nconv(ngeff)
+    integer :: i
+
+    if (.not. activity_active()) return
+    if (.not. call_open) call fail('block outside MCGMRE call')
+    if (block_open) call fail('nested correction block')
+    if (iteration < 1) call fail('invalid block-entry ITER')
+    if (ngeff /= required_groups) call fail('block NGEFF differs')
+    if (correction_block_count >= required_block_capacity) &
+         call fail('correction-block capacity exceeded')
+    if (count(nconv) < 1) call fail('empty correction-block entry')
+
+    correction_block_count = correction_block_count + 1
+    current_block = correction_block_count
+    block_open = .true.
+    block_meta(1, current_block) = current_call
+    block_meta(2, current_block) = call_meta(4, current_call) + 1
+    block_meta(3, current_block) = 0
+    block_meta(4, current_block) = count(nconv)
+    do i = 1, required_groups
+      if (nconv(i)) block_active(i, current_block) = 1
+    end do
+    call_meta(4, current_call) = call_meta(4, current_call) + 1
+  end subroutine SPOMGMR_BLOCK_BEGIN
+
+
+  subroutine SPOMGMR_BLOCK_END(iteration, ngeff, kmax)
+    integer, intent(in) :: iteration, ngeff
+    integer, intent(in) :: kmax(ngeff)
+    integer :: block_max, event, first_event, group, krylov_calls
+    integer :: reconstructed_k
+
+    if (.not. activity_active()) return
+    if (.not. call_open) call fail('block end outside MCGMRE call')
+    if (.not. block_open) call fail('block end without block entry')
+    if (iteration < 1) call fail('invalid block-update ITER')
+    if (ngeff /= required_groups) call fail('block-end NGEFF differs')
+
+    block_meta(3, current_block) = iteration
+    block_max = 0
+    do group = 1, required_groups
+      if ((kmax(group) < 0) .or. (kmax(group) > required_nstart)) &
+           call fail('KMAX outside 0..10')
+      if ((block_active(group, current_block) == 0) .and. &
+           (kmax(group) /= 0)) call fail('inactive group has nonzero KMAX')
+      block_kmax(group, current_block) = kmax(group)
+      block_max = max(block_max, kmax(group))
+    end do
+
+    krylov_calls = 0
+    first_event = 0
+    do event = 1, role_event_count
+      if ((role_events(3, event) == 3) .and. &
+           (role_events(5, event) == current_block)) then
+        krylov_calls = krylov_calls + 1
+        if (first_event == 0) first_event = event
+      end if
+    end do
+    if (krylov_calls /= block_max) &
+         call fail('Krylov-call count does not close block maximum')
+    if (krylov_calls > 0) then
+      do group = 1, required_groups
+        if (role_active(group, first_event) /= &
+             block_active(group, current_block)) &
+             call fail('first Krylov mask differs from block entry')
+      end do
+    end if
+
+    do group = 1, required_groups
+      reconstructed_k = 0
+      first_event = 0
+      do event = 1, role_event_count
+        if ((role_events(3, event) /= 3) .or. &
+             (role_events(5, event) /= current_block)) cycle
+        if ((first_event == 0) .and. &
+             (role_active(group, event) /= &
+              block_active(group, current_block))) &
+             call fail('first per-group Krylov mask differs')
+        if (first_event /= 0) then
+          if (role_active(group, event) > &
+               role_active(group, first_event)) &
+               call fail('Krylov active mask changed 0 to 1')
+        end if
+        reconstructed_k = reconstructed_k + role_active(group, event)
+        first_event = event
+      end do
+      if (reconstructed_k /= kmax(group)) &
+           call fail('KMAX does not close Krylov masks')
+      if ((block_max > 0) .and. &
+           (block_active(group, current_block) == 1) .and. &
+           (kmax(group) < 1)) call fail('active group missed Krylov call')
+      k_histogram(kmax(group)) = k_histogram(kmax(group)) + 1
+      sum_k = sum_k + kmax(group)
+      if (kmax(group) > 0) &
+           nonzero_k_group_block_count = &
+           nonzero_k_group_block_count + 1
+      max_k = max(max_k, kmax(group))
+    end do
+    block_open = .false.
+  end subroutine SPOMGMR_BLOCK_END
+
+
+  subroutine SPOMGMR_MCGMRE_EXIT(iteration)
+    integer, intent(in) :: iteration
+
+    if (.not. activity_active()) return
+    if (.not. call_open) call fail('MCGMRE exit without entry')
+    if (block_open) call fail('MCGMRE exit with open block')
+    if (iteration < 1) call fail('invalid final MCGMRE ITER')
+    if (exit_count /= 0) call fail('second MCGMRE normal exit')
+    call_meta(2, current_call) = 1
+    call_meta(5, current_call) = iteration
+    exit_count = 1
+    call_open = .false.
+  end subroutine SPOMGMR_MCGMRE_EXIT
+
+
+  subroutine SPOMGMR_FINISH()
+    integer :: block, block_max, event, group, i, ilong, itype
+    integer :: recomputed_histogram(0:required_nstart)
+    integer :: recomputed_nonzero, recomputed_sum, recomputed_max
+    integer :: recomputed_role_calls(3), recomputed_role_groups(3)
+
+    if (.not. requested) return
+    if (.not. armed) call fail('audit was not begun')
+    if (complete) call fail('audit already complete')
+    if (call_open) call fail('MCGMRE call has no normal exit')
+    if (block_open) call fail('correction block is still open')
+    if ((entry_count /= 1) .or. (exit_count /= 1)) &
+         call fail('exactly one MCGMRE entry and exit required')
+    if (call_meta(1, 1) /= 1) call fail('CALL-META index differs')
+    if (call_meta(2, 1) /= 1) call fail('normal-exit flag differs')
+    if (call_meta(3, 1) /= role_event_count) &
+         call fail('CALL-META role count differs')
+    if (call_meta(4, 1) /= correction_block_count) &
+         call fail('CALL-META block count differs')
+    if (call_meta(5, 1) < 1) call fail('CALL-META final ITER differs')
+    if (role_calls(1) < 1) call fail('PRIMARY role was not observed')
+
+    recomputed_role_calls = 0
+    recomputed_role_groups = 0
+    do event = 1, role_event_count
+      if (role_events(1, event) /= 1) call fail('role call index differs')
+      if (role_events(2, event) /= event) &
+           call fail('role event index is not contiguous')
+      if ((role_events(3, event) < 1) .or. &
+           (role_events(3, event) > 3)) call fail('role code differs')
+      if (role_events(4, event) < 1) call fail('role ITER differs')
+      if (event > 1) then
+        if (role_events(4, event) < role_events(4, event - 1)) &
+             call fail('role ITER order differs')
+      end if
+      if (role_events(3, event) == 1) then
+        if (role_events(5, event) /= 0) &
+             call fail('PRIMARY block index is not zero')
+      else
+        if ((role_events(5, event) < 1) .or. &
+             (role_events(5, event) > correction_block_count)) &
+             call fail('block role index differs')
+      end if
+      i = 0
+      do group = 1, required_groups
+        if ((role_active(group, event) < 0) .or. &
+             (role_active(group, event) > 1)) &
+             call fail('ROLE-ACTIVE is not binary')
+        i = i + role_active(group, event)
+      end do
+      if (i /= role_events(6, event)) &
+           call fail('role active-group count differs')
+      i = role_events(3, event)
+      recomputed_role_calls(i) = recomputed_role_calls(i) + 1
+      recomputed_role_groups(i) = recomputed_role_groups(i) + &
+           role_events(6, event)
+    end do
+    if (any(recomputed_role_calls /= role_calls)) &
+         call fail('ROLE-CALLS does not close events')
+    if (any(recomputed_role_groups /= role_groups)) &
+         call fail('ROLE-GROUPS does not close masks')
+
+    recomputed_histogram = 0
+    recomputed_nonzero = 0
+    recomputed_sum = 0
+    recomputed_max = 0
+    i = 0
+    do block = 1, correction_block_count
+      if (block_meta(1, block) /= 1) call fail('block call index differs')
+      if (block_meta(2, block) /= block) &
+           call fail('block index is not contiguous')
+      if (block_meta(3, block) < 1) call fail('block update ITER differs')
+      i = 0
+      block_max = 0
+      do group = 1, required_groups
+        if ((block_active(group, block) < 0) .or. &
+             (block_active(group, block) > 1)) &
+             call fail('BLOCK-ACTIVE is not binary')
+        if ((block_kmax(group, block) < 0) .or. &
+             (block_kmax(group, block) > required_nstart)) &
+             call fail('BLOCK-KMAX differs')
+        if ((block_active(group, block) == 0) .and. &
+             (block_kmax(group, block) /= 0)) &
+             call fail('inactive block group has KMAX')
+        i = i + block_active(group, block)
+        block_max = max(block_max, block_kmax(group, block))
+        recomputed_histogram(block_kmax(group, block)) = &
+             recomputed_histogram(block_kmax(group, block)) + 1
+        recomputed_sum = recomputed_sum + block_kmax(group, block)
+        if (block_kmax(group, block) > 0) &
+             recomputed_nonzero = recomputed_nonzero + 1
+        recomputed_max = max(recomputed_max, block_kmax(group, block))
+      end do
+      if (i /= block_meta(4, block)) &
+           call fail('block active-group count differs')
+      i = 0
+      do event = 1, role_event_count
+        if ((role_events(3, event) == 3) .and. &
+             (role_events(5, event) == block)) i = i + 1
+      end do
+      if (i /= block_max) call fail('block maximum differs from calls')
+    end do
+    if (any(recomputed_histogram /= k_histogram)) &
+         call fail('K histogram does not close rows')
+    if (recomputed_nonzero /= nonzero_k_group_block_count) &
+         call fail('nonzero-K count differs')
+    if (recomputed_sum /= sum_k) call fail('sum-K differs')
+    if (recomputed_max /= max_k) call fail('max-K differs')
+    if (sum(k_histogram) /= required_groups*correction_block_count) &
+         call fail('K histogram row count differs')
+    if (role_groups(3) /= sum_k) &
+         call fail('Krylov group sum does not equal sum-K')
+    i = 0
+    do block = 1, correction_block_count
+      i = i + maxval(block_kmax(:, block))
+    end do
+    if (role_calls(3) /= i) &
+         call fail('Krylov call count does not close block maxima')
+
+    call LCMLEN(audit_root, 'STATE-VECTOR', ilong, itype)
+    if ((ilong /= 24) .or. (itype /= 1)) &
+         call fail('initial STATE-VECTOR differs')
+    call require_absent('NGIND')
+    call require_absent('CALL-META')
+    call require_absent('ROLE-CALLS')
+    call require_absent('ROLE-GROUPS')
+    call require_absent('ROLE-EVENTS')
+    call require_absent('ROLE-ACTIVE')
+    call require_absent('K-HISTOGRAM')
+    call require_absent('BLOCK-META')
+    call require_absent('BLOCK-ACTIVE')
+    call require_absent('BLOCK-KMAX')
+
+    state_vector(2) = 1
+    state_vector(9) = entry_count
+    state_vector(10) = exit_count
+    state_vector(11:13) = role_calls
+    state_vector(14:16) = role_groups
+    state_vector(17) = correction_block_count
+    state_vector(18) = nonzero_k_group_block_count
+    state_vector(19) = sum_k
+    state_vector(20) = max_k
+    state_vector(21) = required_maxi
+    state_vector(22) = int(required_errtol_bits, kind(state_vector))
+    state_vector(23:24) = 0
+
+    call LCMPUT(audit_root, 'NGIND', required_groups, 1, ngind_ledger)
+    call LCMPUT(audit_root, 'CALL-META', 5*entry_count, 1, call_meta)
+    call LCMPUT(audit_root, 'ROLE-CALLS', 3, 1, role_calls)
+    call LCMPUT(audit_root, 'ROLE-GROUPS', 3, 1, role_groups)
+    if (role_event_count > 0) then
+      call LCMPUT(audit_root, 'ROLE-EVENTS', 6*role_event_count, 1, &
+           role_events)
+      call LCMPUT(audit_root, 'ROLE-ACTIVE', &
+           required_groups*role_event_count, 1, role_active)
+    end if
+    call LCMPUT(audit_root, 'K-HISTOGRAM', required_nstart + 1, 1, &
+         k_histogram)
+    if (correction_block_count > 0) then
+      call LCMPUT(audit_root, 'BLOCK-META', &
+           4*correction_block_count, 1, block_meta)
+      call LCMPUT(audit_root, 'BLOCK-ACTIVE', &
+           required_groups*correction_block_count, 1, block_active)
+      call LCMPUT(audit_root, 'BLOCK-KMAX', &
+           required_groups*correction_block_count, 1, block_kmax)
+    end if
+    call LCMPUT(audit_root, 'STATE-VECTOR', 24, 1, state_vector)
+    complete = .true.
+    call release_memory()
+  end subroutine SPOMGMR_FINISH
+
+
+  subroutine require_absent(name)
+    character(len=*), intent(in) :: name
+    integer :: ilong, itype
+
+    call LCMLEN(audit_root, name, ilong, itype)
+    if (ilong /= 0) call fail(trim(name)//' already exists')
+  end subroutine require_absent
+
+
+  subroutine release_memory()
+    if (allocated(call_meta)) deallocate(call_meta)
+    if (allocated(role_events)) deallocate(role_events)
+    if (allocated(role_active)) deallocate(role_active)
+    if (allocated(block_meta)) deallocate(block_meta)
+    if (allocated(block_active)) deallocate(block_active)
+    if (allocated(block_kmax)) deallocate(block_kmax)
+    audit_root = c_null_ptr
+    armed = .false.
+    call_open = .false.
+    block_open = .false.
+    entry_count = 0
+    exit_count = 0
+    role_event_count = 0
+    correction_block_count = 0
+    current_call = 0
+    current_block = 0
+    nonzero_k_group_block_count = 0
+    sum_k = 0
+    max_k = 0
+    state_vector = 0
+    ngind_ledger = 0
+    role_calls = 0
+    role_groups = 0
+    k_histogram = 0
+  end subroutine release_memory
+
+
+  subroutine fail(message)
+    character(len=*), intent(in) :: message
+    call XABORT('SPOMGMR: '//trim(message))
+  end subroutine fail
+
+end module SPOMGMR_AUDIT
