****************************************************************
* One direct continuation, axial half: radial response -> x3.  *
****************************************************************

XSM_FILE TRACK_AX :: FILE './initial_axial_track.xsm' ;
XSM_FILE MACROLIB3 :: FILE './initial_axial_macrolib.xsm' ;
XSM_FILE AX2_ARCH :: FILE './state2_axial.xsm' ;
XSM_FILE RADIAL_IN :: FILE './state3_radial.xsm' ;
XSM_FILE SYSTEM_NEXT :: FILE './state3_system.xsm' ;

XSM_FILE AX3_ARCH :: FILE './state3_axial.xsm' ;
XSM_FILE SNAP3_ARCH :: FILE './state3_snapshots.xsm' ;

LINKED_LIST SNAP AX_CURRENT ;
MODULE FLU: SPOGBAL: SPOSTATE: SPOXCONV: SPOLEAK:
       GREP: END: ;

REAL solver_eps := 5.0E-7 ;
REAL k3 leak3_change gbal gbal_group ;
DOUBLE rrho rleak dleak ra ;

ECHO "MAP3-AXIAL-BEGIN" ;
ECHO "MAP3-AXIAL-TOLERANCE" solver_eps ;

SNAP := RADIAL_IN ;
AX_CURRENT := FLU: MACROLIB3 TRACK_AX SYSTEM_NEXT ::
  EDIT -3 TYPE K B1 SIGS EXTE 500 <<solver_eps>>
  UNKT <<solver_eps>> THER <<solver_eps>> ;
AX_CURRENT := SPOGBAL:
  AX_CURRENT TRACK_AX SYSTEM_NEXT MACROLIB3 :: ;
GREP: AX_CURRENT ::
  GETVAL 'K-EFFECTIVE' 1 >>k3<<
  GETVAL 'SPOT-GBAL' 1 >>gbal<<
  GETVAL 'SPOT-GBAL-MAX' 1 >>gbal_group<< ;
AX_CURRENT := SPOSTATE:
  AX_CURRENT TRACK_AX SYSTEM_NEXT MACROLIB3 :: ;

* Raw, unmixed defect of x3=G(x2).
AX_CURRENT := SPOXCONV: AX_CURRENT AX2_ARCH :: ;
GREP: AX_CURRENT ::
  GETVAL 'SPOT-X-RRHO' 1 >>rrho<<
  GETVAL 'SPOT-X-RLEAK' 1 >>rleak<<
  GETVAL 'SPOT-X-DLEAK' 1 >>dleak<<
  GETVAL 'SPOT-X-RA' 1 >>ra<< ;
ECHO "MAP3-RAW-DEFECT" rrho rleak dleak ra ;
ECHO "MAP3-STATE3" k3 gbal gbal_group ;

SNAP := SPOLEAK: SNAP AX_CURRENT TRACK_AX :: >>leak3_change<< ;
ECHO "MAP3-LEAKAGE3" leak3_change ;

AX3_ARCH := AX_CURRENT ;
SNAP3_ARCH := SNAP ;

ECHO "MAP3-AXIAL-COMPLETE" ;
END: ;
QUIT "LIST" .
