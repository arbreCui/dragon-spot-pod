****************************************************************
* VALIDATION-ONLY candidate; production registration forbidden. *
*                                                              *
* Fresh FLUX is the sole publication target. FLUX_OLD is a     *
* distinct read-only seed carrying the previous radial state.   *
****************************************************************
PARAMETER SYSTEM FLUX SNAP MICROLIB2 TRACK TRACK_f FLUX_OLD ::
  ::: LINKED_LIST SYSTEM FLUX SNAP MICROLIB2 TRACK FLUX_OLD ;
  ::: SEQ_BINARY TRACK_f ; ;

LINKED_LIST MACRO0 FSOURCE ;
MODULE SPOFSRC: ASM: FLU: SPOFCHK: DELETE: END: ;

INTEGER isnap ;
REAL keff flu_eps ;
:: >>isnap<< >>keff<< >>flu_eps<< ;

MACRO0 FSOURCE := SPOFSRC: MICROLIB2 TRACK FLUX_OLD ::
  KEFF <<keff>> ;

SYSTEM := ASM: MACRO0 TRACK TRACK_f SNAP ::
  EDIT 0 ARM LK1D <<isnap>> ;

FLUX := FLU: MACRO0 TRACK TRACK_f SYSTEM FSOURCE FLUX_OLD ::
  EDIT 0 TYPE S INIT ON REBA
  EXTE 500 <<flu_eps>>
  UNKT <<flu_eps>> THER 740 <<flu_eps>>
  ACCE 3 3 R64 ;

FLUX := SPOFCHK: FLUX FLUX_OLD TRACK SYSTEM FSOURCE :: ;
MACRO0 FSOURCE := DELETE: MACRO0 FSOURCE ;

END: ;
