****************************************************************
* B2y: one supplied RETURNED/1 to CLOSED/1 axial half-step.     *
*                                                              *
* Exactly one SpotCloseR64 call; no radial solve or Picard loop. *
****************************************************************

XSM_FILE RET_XSM :: FILE './returned.xsm' ;
XSM_FILE TRACK_XSM :: FILE './initial_axial_track.xsm' ;
XSM_FILE MACRO_XSM :: FILE './initial_axial_macrolib.xsm' ;
XSM_FILE BASIS_XSM :: FILE './basis_reference.xsm' ;
XSM_FILE AX_OUT :: FILE './ax_closed.xsm' ;
XSM_FILE ARCH_OUT :: FILE './archive_closed.xsm' ;

LINKED_LIST RETURNED TRACK_AX MACROLIB3 BASIS_REF
            AX_CLOSED ARCH_CLOSED ;
MODULE DELETE: END: ;
PROCEDURE SpotCloseR64 ;

RETURNED := RET_XSM ;
TRACK_AX := TRACK_XSM ;
MACROLIB3 := MACRO_XSM ;
BASIS_REF := BASIS_XSM ;

ECHO "B2Y-REAL-RETURNED-CLOSE-BEGIN" ;
AX_CLOSED ARCH_CLOSED := SpotCloseR64
  RETURNED TRACK_AX MACROLIB3 BASIS_REF :: ;
AX_OUT := AX_CLOSED ;
ARCH_OUT := ARCH_CLOSED ;
ECHO "B2Y-REAL-RETURNED-CLOSE-COMPLETE" ;

RETURNED TRACK_AX MACROLIB3 BASIS_REF AX_CLOSED ARCH_CLOSED := DELETE:
  RETURNED TRACK_AX MACROLIB3 BASIS_REF AX_CLOSED ARCH_CLOSED ;
END: ;
QUIT "LIST" .
