****************************************************************
* D4-A first axial solve: cold direct-Picard REAL64 state mint. *
* Consumes the three products of d4a_rank2_basis.x2m (axial     *
* track, SPOLIB macrolib, SPOD system) plus the admitted        *
* snapshot archive.  No parent exists yet, so FLU starts from   *
* its flat guess and no SPOXCONV defect is defined; the state   *
* minted here is the parent of every later D4-A map.  The rank  *
* and floor count are whatever the basis deck produced - this   *
* deck imposes neither.                                         *
****************************************************************

XSM_FILE TRACK_AX :: FILE './d4a_axial_track.xsm' ;
XSM_FILE MACROLIB3 :: FILE './d4a_axial_macrolib.xsm' ;
XSM_FILE SYSTEM_IN :: FILE './d4a_rank2_basis.xsm' ;
XSM_FILE SNAP_IN :: FILE './d4a_snapshots.xsm' ;

XSM_FILE SEED_AX :: FILE './d4a_seed_axial.xsm' ;
XSM_FILE SEED_SNAP :: FILE './d4a_seed_snapshots.xsm' ;

LINKED_LIST SNAP AX_CURRENT ;
MODULE FLU: SPOGBAL: SPOSTATE: SPOLEAK: GREP: END: ;

* Declared terminal, consistent with the snapshot-solve declaration
* of 2026-08-26 (the D4-A flux-image channels floor near 1e-6).
REAL solver_eps := 2.0E-6 ;
REAL k_seed leak_change gbal gbal_group ;

ECHO "D4A-AXIAL-SEED-BEGIN" ;
ECHO "D4A-AXIAL-SEED-TOLERANCE" solver_eps ;

SNAP := SNAP_IN ;

AX_CURRENT := FLU: MACROLIB3 TRACK_AX SYSTEM_IN ::
  EDIT 1 TYPE K EXTE 500 <<solver_eps>> REBA OFF ACCE 3 3
  UNKT <<solver_eps>> THER <<solver_eps>> ;
AX_CURRENT := SPOGBAL:
  AX_CURRENT TRACK_AX SYSTEM_IN MACROLIB3 :: ;
GREP: AX_CURRENT ::
  GETVAL 'K-EFFECTIVE' 1 >>k_seed<<
  GETVAL 'SPOT-GBAL' 1 >>gbal<<
  GETVAL 'SPOT-GBAL-MAX' 1 >>gbal_group<< ;
AX_CURRENT := SPOSTATE:
  AX_CURRENT TRACK_AX SYSTEM_IN MACROLIB3 :: ;
ECHO "D4A-AXIAL-SEED-CANDIDATE" k_seed gbal gbal_group ;

SNAP := SPOLEAK: SNAP AX_CURRENT TRACK_AX :: >>leak_change<< ;
ECHO "D4A-AXIAL-SEED-LEAKAGE" leak_change ;

SEED_AX := AX_CURRENT ;
SEED_SNAP := SNAP ;

ECHO "D4A-AXIAL-SEED-COMPLETE" ;
END: ;
QUIT "LIST" .
