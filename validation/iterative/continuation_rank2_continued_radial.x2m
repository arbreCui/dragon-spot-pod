****************************************************************
* One continued rank-2 map, radial half: parent -> response.    *
****************************************************************

SEQ_BINARY TRACK_f :: FILE './initial_radial_track.bin' ;

XSM_FILE PARENT_SNAP :: FILE './parent_snapshots.xsm' ;
XSM_FILE TRACK_AX :: FILE './initial_axial_track.xsm' ;
XSM_FILE MACROLIB3 :: FILE './initial_axial_macrolib.xsm' ;
XSM_FILE BASIS_REF :: FILE './basis_reference.xsm' ;
XSM_FILE PARENT_AX :: FILE './parent_axial.xsm' ;

XSM_FILE SYSTEM_OUT :: FILE './candidate_system.xsm' ;
XSM_FILE RADIAL_OUT :: FILE './candidate_radial.xsm' ;

LINKED_LIST SNAP TRACK SYSTEM_NEXT ;
MODULE RECOVER: ASM: SPOPROJ: GREP: END: ;
PROCEDURE SpotRefFS ;

INTEGER spod_rank := 2 ;
REAL solver_eps := 5.0E-7 ;
REAL k_parent ;
INTEGER fixed_marker fs_count ;
DOUBLE rbal source_l2 source_max ;

ECHO "CONT-RADIAL-BEGIN" ;
ECHO "CONT-RADIAL-TOLERANCE" solver_eps ;

* The parent is already a canonical rank-2 state and the snapshot archive
* already contains its returned leakage.  No re-encoding is performed.
SNAP := PARENT_SNAP ;
TRACK := RECOVER: SNAP :: ITEM 3 ;
GREP: PARENT_AX :: GETVAL 'K-EFFECTIVE' 1 >>k_parent<< ;

* Reconstruct B_2*a_parent and solve three frozen-fission radial equations.
SNAP := SPOPROJ: SNAP PARENT_AX TRACK_AX :: FIXB ;
SNAP := SpotRefFS SNAP TRACK TRACK_f ::
  <<k_parent>> <<solver_eps>> ;

* Keep the frozen rank-2 POD package; rebuild only the live radial response.
SYSTEM_NEXT := ASM: MACROLIB3 TRACK_AX SNAP BASIS_REF ::
  EDIT 0 SPOD <<spod_rank>> FIXB ;
GREP: SYSTEM_NEXT ::
  GETVAL 'SPOT-FIXB' 1 >>fixed_marker<<
  GETVAL 'SPOT-FS-N' 1 >>fs_count<<
  GETVAL 'SPOT-RBAL' 1 >>rbal<<
  GETVAL 'SPOT-Q-L2' 1 >>source_l2<<
  GETVAL 'SPOT-Q-MAX' 1 >>source_max<< ;
ECHO "CONT-RADIAL-CONTRACT"
  fixed_marker fs_count rbal source_l2 source_max ;

SYSTEM_OUT := SYSTEM_NEXT ;
RADIAL_OUT := SNAP ;

ECHO "CONT-RADIAL-COMPLETE" ;
END: ;
QUIT "LIST" .
