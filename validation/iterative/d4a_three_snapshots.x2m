****************************************************************
* IRENA D4-A: exactly three frozen physical radial snapshots.   *
* This deck builds the offline archive only. It performs no POD, *
* axial solve, online feedback or outer iteration.               *
****************************************************************

SEQ_ASCII glow_rnr :: FILE './geometry.dat' ;
SEQ_BINARY TRACK_f ;
XSM_FILE SNAP_ARCH :: FILE './d4a_snapshots.xsm' ;

LINKED_LIST TRACK MICROLIB2 SYSTEM FLUX SNAP ;

MODULE BACKUP: DELETE: END: ;
PROCEDURE SpotD4Snap rnr_cc rnr_interpol ;

REAL T_clad := 620.0 ;
REAL T_Na := 475.0 ;
REAL solver_eps := 5.0E-7 ;

ECHO "D4A-SNAPSHOT-STATE" 1 650.0 T_clad T_Na ;
MICROLIB2 SYSTEM FLUX TRACK TRACK_f := SpotD4Snap glow_rnr ::
  650.0 <<T_clad>> <<T_Na>> <<solver_eps>> ;
SNAP := BACKUP: TRACK :: LIST 3 ITEM 1 ;
SNAP := BACKUP: SNAP MICROLIB2 :: ITEM 1 ;
SNAP := BACKUP: SNAP SYSTEM :: ITEM 1 ;
SNAP := BACKUP: SNAP FLUX :: ITEM 1 ;
MICROLIB2 SYSTEM FLUX TRACK TRACK_f := DELETE:
  MICROLIB2 SYSTEM FLUX TRACK TRACK_f ;
ECHO "D4A-SNAPSHOT-COMPLETE" 1 ;

ECHO "D4A-SNAPSHOT-STATE" 2 750.0 T_clad T_Na ;
MICROLIB2 SYSTEM FLUX TRACK TRACK_f := SpotD4Snap glow_rnr ::
  750.0 <<T_clad>> <<T_Na>> <<solver_eps>> ;
SNAP := BACKUP: SNAP TRACK :: ITEM 2 ;
SNAP := BACKUP: SNAP MICROLIB2 :: ITEM 2 ;
SNAP := BACKUP: SNAP SYSTEM :: ITEM 2 ;
SNAP := BACKUP: SNAP FLUX :: ITEM 2 ;
MICROLIB2 SYSTEM FLUX TRACK TRACK_f := DELETE:
  MICROLIB2 SYSTEM FLUX TRACK TRACK_f ;
ECHO "D4A-SNAPSHOT-COMPLETE" 2 ;

ECHO "D4A-SNAPSHOT-STATE" 3 850.0 T_clad T_Na ;
MICROLIB2 SYSTEM FLUX TRACK TRACK_f := SpotD4Snap glow_rnr ::
  850.0 <<T_clad>> <<T_Na>> <<solver_eps>> ;
SNAP := BACKUP: SNAP TRACK :: ITEM 3 ;
SNAP := BACKUP: SNAP MICROLIB2 :: ITEM 3 ;
SNAP := BACKUP: SNAP SYSTEM :: ITEM 3 ;
SNAP := BACKUP: SNAP FLUX :: ITEM 3 ;
MICROLIB2 SYSTEM FLUX TRACK TRACK_f := DELETE:
  MICROLIB2 SYSTEM FLUX TRACK TRACK_f ;
ECHO "D4A-SNAPSHOT-COMPLETE" 3 ;

SNAP_ARCH := SNAP ;
ECHO "D4A-THREE-SNAPSHOT-ARCHIVE-COMPLETE" ;
END: ;
QUIT "LIST" .
