****************************************************************
* Stage 4 v2: one coarse 2h map from the frozen Stage-3 x0.    *
*                                                              *
* The POD basis and x0 are read from the frozen fine artifact. *
* Exactly three radial fixed-source solves and one returned     *
* axial solve use 2h=1.0E-6.  There is no initializer, outer    *
* loop, relaxation, fit, clipping, or empirical coefficient.    *
****************************************************************

SEQ_BINARY TRACK_f :: FILE './initial_radial_track.bin' ;

XSM_FILE SNAP_SEED :: FILE './initial_snapshots.xsm' ;
XSM_FILE TRACK_AX :: FILE './initial_axial_track.xsm' ;
XSM_FILE MACROLIB3 :: FILE './initial_axial_macrolib.xsm' ;

XSM_FILE BASIS_REF :: FILE './basis_reference.xsm' ;
XSM_FILE AX0_ARCH :: FILE './state0_axial.xsm' ;
XSM_FILE SYS1_ARCH :: FILE './state1_system.xsm' ;
XSM_FILE AX1_ARCH :: FILE './state1_axial.xsm' ;
XSM_FILE SNAP1_ARCH :: FILE './state1_snapshots.xsm' ;

LINKED_LIST SNAP TRACK SYSTEM_NEXT AX_CURRENT ;

MODULE RECOVER: ASM: FLU: SPOSTATE: SPOXCONV:
       SPOPROJ: SPOLEAK: GREP: END: ;
PROCEDURE SpotRefFS ;

INTEGER spod_rank := 1 ;
REAL coarse_eps := 1.0E-6 ;
REAL k0 k1 ;
REAL leak0_change leak1_change ;
INTEGER fixed_marker fs_count ;
DOUBLE rbal source_l2 source_max ;
DOUBLE rrho rleak dleak ra ;

ECHO "STAGE4V2-COARSE-BEGIN" ;
ECHO "STAGE4V2-COARSE-RANK" spod_rank ;
ECHO "STAGE4V2-COARSE-TOLERANCE" coarse_eps ;

SNAP := RECOVER: SNAP_SEED :: ITEM 1 ;
TRACK := RECOVER: SNAP :: ITEM 3 ;

****************************************************************
* Restore the frozen x0 without rebuilding B or solving x0.    *
****************************************************************
GREP: AX0_ARCH :: GETVAL 'K-EFFECTIVE' 1 >>k0<< ;
ECHO "STAGE4V2-COARSE-X0-REUSED" ;
ECHO "STAGE4V2-COARSE-STATE0" k0 ;

* Store the undamped frozen leakage L0 in the radial systems.
SNAP := SPOLEAK: SNAP AX0_ARCH TRACK_AX :: >>leak0_change<< ;
ECHO "STAGE4V2-COARSE-LEAKAGE0" leak0_change ;

* Reconstruct the radial feedback strictly as B*a0.
SNAP := SPOPROJ: SNAP AX0_ARCH TRACK_AX :: FIXB ;

****************************************************************
* Evaluate x1_2h=G_2h(x0) exactly once.                        *
****************************************************************
ECHO "STAGE4V2-COARSE-RADIAL-BEGIN" ;
SNAP := SpotRefFS SNAP TRACK TRACK_f ::
  <<k0>> <<coarse_eps>> ;
ECHO "STAGE4V2-COARSE-RADIAL-END" ;

SYSTEM_NEXT := ASM: MACROLIB3 TRACK_AX SNAP BASIS_REF ::
  EDIT 1 SPOD <<spod_rank>> FIXB ;
GREP: SYSTEM_NEXT :: GETVAL 'SPOT-FIXB' 1 >>fixed_marker<< ;
GREP: SYSTEM_NEXT :: GETVAL 'SPOT-FS-N' 1 >>fs_count<< ;
GREP: SYSTEM_NEXT :: GETVAL 'SPOT-RBAL' 1 >>rbal<< ;
GREP: SYSTEM_NEXT :: GETVAL 'SPOT-Q-L2' 1 >>source_l2<< ;
GREP: SYSTEM_NEXT :: GETVAL 'SPOT-Q-MAX' 1 >>source_max<< ;
ECHO "STAGE4V2-COARSE-RADIAL-CONTRACT"
  fixed_marker fs_count rbal source_l2 source_max ;

ECHO "STAGE4V2-COARSE-AXIAL-BEGIN" ;
AX_CURRENT := FLU: MACROLIB3 TRACK_AX SYSTEM_NEXT ::
  EDIT -3 TYPE K B1 SIGS EXTE 500 <<coarse_eps>>
  UNKT <<coarse_eps>> THER <<coarse_eps>> ;
ECHO "STAGE4V2-COARSE-AXIAL-END" ;

GREP: AX_CURRENT :: GETVAL 'K-EFFECTIVE' 1 >>k1<< ;
AX_CURRENT := SPOSTATE:
  AX_CURRENT TRACK_AX SYSTEM_NEXT MACROLIB3 :: ;

AX_CURRENT := SPOXCONV: AX_CURRENT AX0_ARCH :: ;
GREP: AX_CURRENT :: GETVAL 'SPOT-X-RRHO' 1 >>rrho<< ;
GREP: AX_CURRENT :: GETVAL 'SPOT-X-RLEAK' 1 >>rleak<< ;
GREP: AX_CURRENT :: GETVAL 'SPOT-X-DLEAK' 1 >>dleak<< ;
GREP: AX_CURRENT :: GETVAL 'SPOT-X-RA' 1 >>ra<< ;
ECHO "STAGE4V2-COARSE-DOUT-2H" rrho rleak dleak ra ;
ECHO "STAGE4V2-COARSE-STATE1" k1 ;

* Close x1_2h with the fresh, undamped leakage L1.
SNAP := SPOLEAK: SNAP AX_CURRENT TRACK_AX :: >>leak1_change<< ;
ECHO "STAGE4V2-COARSE-LEAKAGE1" leak1_change ;

SYS1_ARCH := SYSTEM_NEXT ;
AX1_ARCH := AX_CURRENT ;
SNAP1_ARCH := SNAP ;

ECHO "STAGE4V2-COARSE-COMPLETE" ;
END: ;
QUIT "LIST" .
