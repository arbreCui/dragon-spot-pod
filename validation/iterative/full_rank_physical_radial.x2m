****************************************************************
* One physical-full-rank REAL64 direct-Picard radial response.  *
****************************************************************

SEQ_BINARY TRACK_f :: FILE './initial_radial_track.bin' ;

XSM_FILE PROJECTED_IN :: FILE './projected_parent.xsm' ;
XSM_FILE TRACK_AX :: FILE './initial_axial_track.xsm' ;
XSM_FILE MACROLIB3 :: FILE './initial_axial_macrolib.xsm' ;
XSM_FILE BASIS_REF :: FILE './basis_physical.xsm' ;
XSM_FILE RCONTRACT_IN :: FILE './route_contract.xsm' ;

XSM_FILE SYSTEM_OUT :: FILE './candidate_system.xsm' ;
XSM_FILE RADIAL_OUT :: FILE './candidate_radial.xsm' ;

LINKED_LIST PROJECTED RETURNED SYSTEM_NEXT RCONTRACT ;
MODULE ASM: GREP: END: ;
PROCEDURE SpotStepR64 ;

INTEGER spod_rank := 8 ;
INTEGER fixed_marker fs_count ;
DOUBLE rbal source_l2 source_max ;

ECHO "FULL-RANK-PHYSICAL-RADIAL-BEGIN" ;

PROJECTED := PROJECTED_IN ;
RCONTRACT := RCONTRACT_IN ;
RETURNED := SpotStepR64 PROJECTED TRACK_f RCONTRACT :: ;

SYSTEM_NEXT := ASM: MACROLIB3 TRACK_AX RETURNED BASIS_REF ::
  EDIT 0 SPOD <<spod_rank>> FIXB ;
GREP: SYSTEM_NEXT ::
  GETVAL 'SPOT-FIXB' 1 >>fixed_marker<<
  GETVAL 'SPOT-FS-N' 1 >>fs_count<<
  GETVAL 'SPOT-RBAL' 1 >>rbal<<
  GETVAL 'SPOT-Q-L2' 1 >>source_l2<<
  GETVAL 'SPOT-Q-MAX' 1 >>source_max<< ;
ECHO "FULL-RANK-PHYSICAL-RADIAL-CONTRACT"
  fixed_marker fs_count rbal source_l2 source_max ;

SYSTEM_OUT := SYSTEM_NEXT ;
RADIAL_OUT := RETURNED ;

ECHO "FULL-RANK-PHYSICAL-RADIAL-COMPLETE" ;
END: ;
QUIT "LIST" .
