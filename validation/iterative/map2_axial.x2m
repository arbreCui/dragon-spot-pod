****************************************************************
* One direct continuation, axial half: radial response -> x2.  *
****************************************************************

XSM_FILE TRACK_AX :: FILE './initial_axial_track.xsm' ;
XSM_FILE MACROLIB3 :: FILE './initial_axial_macrolib.xsm' ;
XSM_FILE AX1_ARCH :: FILE './state1_axial.xsm' ;
XSM_FILE RADIAL_IN :: FILE './state2_radial.xsm' ;
XSM_FILE SYSTEM_NEXT :: FILE './state2_system.xsm' ;

XSM_FILE AX2_ARCH :: FILE './state2_axial.xsm' ;
XSM_FILE SNAP2_ARCH :: FILE './state2_snapshots.xsm' ;

LINKED_LIST SNAP AX_CURRENT ;
MODULE FLU: SPOGBAL: SPOSTATE: SPOXCONV: SPOLEAK:
       GREP: END: ;

REAL solver_eps := 5.0E-7 ;
REAL k2 leak2_change gbal gbal_group ;
DOUBLE rrho rleak dleak ra ;

ECHO "MAP2-AXIAL-BEGIN" ;
ECHO "MAP2-AXIAL-TOLERANCE" solver_eps ;

SNAP := RADIAL_IN ;
AX_CURRENT := FLU: MACROLIB3 TRACK_AX SYSTEM_NEXT ::
  EDIT -3 TYPE K B1 SIGS EXTE 500 <<solver_eps>>
  UNKT <<solver_eps>> THER <<solver_eps>> ;
AX_CURRENT := SPOGBAL:
  AX_CURRENT TRACK_AX SYSTEM_NEXT MACROLIB3 :: ;
GREP: AX_CURRENT ::
  GETVAL 'K-EFFECTIVE' 1 >>k2<<
  GETVAL 'SPOT-GBAL' 1 >>gbal<<
  GETVAL 'SPOT-GBAL-MAX' 1 >>gbal_group<< ;
AX_CURRENT := SPOSTATE:
  AX_CURRENT TRACK_AX SYSTEM_NEXT MACROLIB3 :: ;

* Raw, unmixed defect of x2=G(x1).
AX_CURRENT := SPOXCONV: AX_CURRENT AX1_ARCH :: ;
GREP: AX_CURRENT ::
  GETVAL 'SPOT-X-RRHO' 1 >>rrho<<
  GETVAL 'SPOT-X-RLEAK' 1 >>rleak<<
  GETVAL 'SPOT-X-DLEAK' 1 >>dleak<<
  GETVAL 'SPOT-X-RA' 1 >>ra<< ;
ECHO "MAP2-RAW-DEFECT" rrho rleak dleak ra ;
ECHO "MAP2-STATE2" k2 gbal gbal_group ;

* Direct leakage return; no damping or mixing.
SNAP := SPOLEAK: SNAP AX_CURRENT TRACK_AX :: >>leak2_change<< ;
ECHO "MAP2-LEAKAGE2" leak2_change ;

AX2_ARCH := AX_CURRENT ;
SNAP2_ARCH := SNAP ;

ECHO "MAP2-AXIAL-COMPLETE" ;
END: ;
QUIT "LIST" .
