****************************************************************
* Re-express one closed state in the exact physical radial basis.*
* No transport, iteration, relaxation, or model change occurs.  *
****************************************************************

XSM_FILE BASIS_POD :: FILE './basis_pod.xsm' ;
XSM_FILE BASIS_PHYS :: FILE './basis_physical.xsm' ;
XSM_FILE TRACK_AX :: FILE './initial_axial_track.xsm' ;
XSM_FILE MACROLIB3 :: FILE './initial_axial_macrolib.xsm' ;
XSM_FILE PARENT_RAW :: FILE './parent_axial.xsm' ;
XSM_FILE PARENT_CL :: FILE './parent_axial_closed.xsm' ;

MODULE SPOPHYS: SPOSTATE: UTL: END: ;

BASIS_PHYS := SPOPHYS: BASIS_POD :: ;

* The raw copy is the immutable defect parent used by SPOXCONV.
PARENT_RAW := UTL: PARENT_RAW ::
  EDIT 0
  DEL 'SPOT-X-STATE'
  DEL 'SPOT-X-EPOCH'
  DEL 'SPOT-X-RRHO'
  DEL 'SPOT-X-RLEAK'
  DEL 'SPOT-X-DLEAK'
  DEL 'SPOT-X-RA' ;
PARENT_RAW := SPOSTATE:
  PARENT_RAW TRACK_AX BASIS_PHYS MACROLIB3 :: ;

* The closed copy retains the exact lifecycle authority consumed by B2J.
PARENT_CL := SPOSTATE:
  PARENT_CL TRACK_AX BASIS_PHYS MACROLIB3 :: ;

ECHO "FULL-RANK-PHYSICAL-REENCODE-COMPLETE" ;
END: ;
QUIT "LIST" .
