****************************************************************
* Stub-only B2u OFF witness: the procedure is never selected.  *
****************************************************************
LINKED_LIST PROJECTED RETURNED ;
SEQ_BINARY TRACK_f :: FILE './track.bin' ;
PROCEDURE SpotStepR64 ;
MODULE B2UFIX: END: ;
INTEGER ENABLE := 0 ;

IF ENABLE 1 = THEN
  PROJECTED := B2UFIX: :: ;
  RETURNED := SpotStepR64 PROJECTED TRACK_f :: ;
ENDIF ;

END: ;
