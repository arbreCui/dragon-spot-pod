* NEW CASE ROOT64_NEW_WARM_B_20261012; LCM CASE-NAME R64WARM-B-V1.
* True native REAL64 warm guess from the independently bit-checked B archive.
* Full A material/geometry/track and original controls are retained.
* Plane 2 / epoch 0 is an input binding, not GLOBAL or CLOSED qualification.
SEQ_ASCII glow :: FILE './geometry.dat' ;
SEQ_BINARY TRACK_f :: FILE './radial_track.bin' ;
XSM_FILE MAT_IN :: FILE './material.xsm' ;
XSM_FILE SEED_IN :: FILE './snapshot_B.xsm' ;
XSM_FILE SNAP_OUT :: FILE './new_native_B.xsm' ;
LINKED_LIST MICROLIB2 MACRO TRACK SYSTEM FLUX SNAP SEEDSET
  RCONTRACT BOOT_BIND ;
MODULE RECOVER: SALT: MCCGT: ASM: FLUNAT64: AXNCASEB64:
  GREP: BACKUP: ABORT: END: ;
INTEGER ng nmix nfis ;
REAL k_snap ;
MICROLIB2 := MAT_IN ;
MACRO := MICROLIB2 :: STEP UP MACROLIB ;
GREP: MACRO :: GETVAL 'STATE-VECTOR' 1 >>ng<< ;
GREP: MACRO :: GETVAL 'STATE-VECTOR' 2 >>nmix<< ;
GREP: MACRO :: GETVAL 'STATE-VECTOR' 4 >>nfis<< ;
IF ng 370 <> THEN
  ECHO "AXMAT: wrong energy-group count" ; ABORT: ;
ENDIF ;
IF nmix 8 <> THEN
  ECHO "AXMAT: wrong mixture count" ; ABORT: ;
ENDIF ;
IF nfis 32 <> THEN
  ECHO "AXMAT: expected 32 fission components" ; ABORT: ;
ENDIF ;
TRACK TRACK_f := SALT: glow ::
  EDIT 0 ANIS 1 TISO 48 1.00000000E+02 LONG ;
TRACK := MCCGT: TRACK TRACK_f ::
  EDIT 0 GAUS 4 AAC 80 TMT STIS 1 EPSI 2.50000000E-08 MCU 10000 ;
SYSTEM := ASM: MICROLIB2 TRACK TRACK_f :: EDIT 0 ARM ;
SEEDSET := SEED_IN ;
FLUX := RECOVER: SEEDSET :: ITEM 1 ;
RCONTRACT BOOT_BIND := AXNCASEB64: :: ;
FLUX := FLUNAT64: FLUX SYSTEM MICROLIB2 TRACK TRACK_f
  RCONTRACT BOOT_BIND ::
  EDIT 2 TYPE K EXTE 500 2.50000000E-07
  UNKT 2.50000000E-07 THER 2.50000000E-07 REBA INIT ON ;
GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 >>k_snap<< ;
SNAP := BACKUP: TRACK :: LIST 1 ITEM 1 ;
SNAP := BACKUP: SNAP MICROLIB2 :: ITEM 1 ;
SNAP := BACKUP: SNAP SYSTEM :: ITEM 1 ;
SNAP := BACKUP: SNAP FLUX :: ITEM 1 ;
SNAP := BACKUP: SNAP RCONTRACT BOOT_BIND :: ITEM 1 ;
SNAP_OUT := SNAP ;
ECHO "ROOT64-NEW-WARM-B-NATIVE-COMPLETE" k_snap ;
END: ;
QUIT "LIST" .
