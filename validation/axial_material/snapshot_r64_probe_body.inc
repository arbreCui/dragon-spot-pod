* Isolated first-call experiment; never returns to publish a snapshot.
      INTEGER MST(40),NBTR0,NCOM0,IFMT0,JG,JF,NFAIL64,NFAIL32,NBAD
      INTEGER NCAP,ITCAP(NGEFF)
      INTEGER(KIND=8) CUTOFF
      LOGICAL OK,OKCAP
      CHARACTER TEXT4*4
      DOUBLE PRECISION DEN,RT64,RT32,RTBAD,REPEAT,EPSACC
      DOUBLE PRECISION, ALLOCATABLE :: Q64(:,:),X64(:,:),XROUND(:,:),
     1 R64(:,:),RREP(:,:),RROUND(:,:),RNEG(:,:),XNEG(:,:),XINIT(:,:),
     2 S64(:,:),HIST(:,:),EPS64(:),LEAK64(:),HCAP(:,:),ECAP(:)
      REAL, ALLOCATABLE :: SC32(:,:,:)
      LOGICAL, ALLOCATABLE :: ACTIVE(:),ACAP(:)
      IF(NUN.NE.14.OR.NGEFF.NE.370.OR.NREG.NE.8.OR.M.NE.8)
     1 CALL XABORT('AXMAT R64: UNDECLARED SHAPE')
      IF(NANI.NE.1.OR.NLIN.NE.1.OR.NFUNL.NE.1.OR.NLONG.NE.14)
     1 CALL XABORT('AXMAT R64: UNDECLARED MOMENTS')
      IF(CYCLIC.OR.LPRISM.OR..NOT.LFORW.OR.NDIM.NE.2)
     1 CALL XABORT('AXMAT R64: UNDECLARED GEOMETRY')
      IF(MAXI.NE.20.OR.NSTART.NE.10.OR.IAAC.NE.80.OR.ISCR.NE.0)
     1 CALL XABORT('AXMAT R64: UNDECLARED CONTROLS')
      IF(STIS.NE.1.OR.NPJJM.NE.1.OR.IDIR.NE.0.OR.NBATCH.NE.1)
     1 CALL XABORT('AXMAT R64: UNDECLARED INTEGRATION')
      IF(ERRTOL.NE.2.5E-8)
     1 CALL XABORT('AXMAT R64: UNDECLARED TOLERANCE')
      ALLOCATE(Q64(NUN,NGEFF),X64(NUN,NGEFF),XROUND(NUN,NGEFF),
     1 R64(NUN,NGEFF),RREP(NUN,NGEFF),RROUND(NUN,NGEFF),
     2 RNEG(NUN,NGEFF),XNEG(NUN,NGEFF),XINIT(NUN,NGEFF),
     3 S64(NUN,NGEFF),HIST(41,NGEFF),EPS64(NGEFF),
     4 LEAK64(NGROUP),SC32(0:M,1,NGEFF),ACTIVE(NGEFF),
     5 HCAP(5,NGEFF),ECAP(NGEFF),ACAP(NGEFF))
      Q64=DBLE(QFR)
      XINIT=DBLE(PHIIN)
      X64=XINIT
      S64=0.0D0
      LEAK64=0.0D0
      HIST=0.0D0
      EPS64=0.0D0
      ACTIVE=.TRUE.
      LNCONV=NGEFF
      CALL LCMGET(IPTRK,'MCCG-STATE',MST)
      REWIND IFTRAK
      READ(IFTRAK) TEXT4,NCOM0,NBTR0,IFMT0
      DO JG=1,NGEFF
        CALL LCMGET(KPSYS(JG),'DRAGON-S0XSC',SC32(:,:,JG))
      ENDDO
      EPSACC=DBLE(ERRTOL)/100.0D0
* Positive solve using the existing double-precision core.
      CALL MCGMRE64(KPSYS,IPTRK,IFTRAK,0,NGEFF,NGIND,NUN,
     1 NREG,M,NLONG,NBTR0,NMAX,NMU,NANGL,NBATCH,LC,MST(17),
     2 PACA,MATALB,KEYFLX,KEYCUR,NZON,VOL,CAZ1,CAZ2,CPO,ZMU,
     3 WZMU,SC32,SIGAL,LEAK64,Q64,X64,S64,R64,DBLE(ERRTOL),
     4 HIST,EPS64,ITST,ACTIVE,LNCONV,CUTOFF,OK)
      IF(.NOT.OK.OR.LNCONV.NE.0)
     1 CALL XABORT('AXMAT R64: POSITIVE CORE FAILED')
      ACTIVE=.TRUE.
      CALL MCGFL164(KPSYS,IPTRK,IFTRAK,0,NGEFF,NGIND,NUN,
     1 NREG,M,NLONG,NBTR0,NMAX,NMU,NANGL,NBATCH,LC,MST(17),
     2 PACA,MATALB,KEYFLX,KEYCUR,NZON,VOL,CAZ1,CAZ2,CPO,ZMU,
     3 WZMU,SC32,SIGAL,LEAK64,Q64,X64,S64,R64,ACTIVE,
     4 EPSACC,CUTOFF,OK)
      IF(.NOT.OK) CALL XABORT('AXMAT R64: FRESH APPLY FAILED')
      CALL MCGFL164(KPSYS,IPTRK,IFTRAK,0,NGEFF,NGIND,NUN,
     1 NREG,M,NLONG,NBTR0,NMAX,NMU,NANGL,NBATCH,LC,MST(17),
     2 PACA,MATALB,KEYFLX,KEYCUR,NZON,VOL,CAZ1,CAZ2,CPO,ZMU,
     3 WZMU,SC32,SIGAL,LEAK64,Q64,X64,S64,RREP,ACTIVE,
     4 EPSACC,CUTOFF,OK)
      IF(.NOT.OK) CALL XABORT('AXMAT R64: REPEAT APPLY FAILED')
* Audit the exact legacy binary32 serialization independently.
      XROUND=DBLE(REAL(X64))
      CALL MCGFL164(KPSYS,IPTRK,IFTRAK,0,NGEFF,NGIND,NUN,
     1 NREG,M,NLONG,NBTR0,NMAX,NMU,NANGL,NBATCH,LC,MST(17),
     2 PACA,MATALB,KEYFLX,KEYCUR,NZON,VOL,CAZ1,CAZ2,CPO,ZMU,
     3 WZMU,SC32,SIGAL,LEAK64,Q64,XROUND,S64,RROUND,ACTIVE,
     4 EPSACC,CUTOFF,OK)
      IF(.NOT.OK) CALL XABORT('AXMAT R64: ROUND APPLY FAILED')
* A corrupted terminal must fail the same fresh-residual test.
      XNEG=1.01D0*X64
      CALL MCGFL164(KPSYS,IPTRK,IFTRAK,0,NGEFF,NGIND,NUN,
     1 NREG,M,NLONG,NBTR0,NMAX,NMU,NANGL,NBATCH,LC,MST(17),
     2 PACA,MATALB,KEYFLX,KEYCUR,NZON,VOL,CAZ1,CAZ2,CPO,ZMU,
     3 WZMU,SC32,SIGAL,LEAK64,Q64,XNEG,S64,RNEG,ACTIVE,
     4 EPSACC,CUTOFF,OK)
      IF(.NOT.OK) CALL XABORT('AXMAT R64: NEGATIVE APPLY FAILED')
      NFAIL64=0
      NFAIL32=0
      NBAD=0
      DO JG=1,NGEFF
        DEN=SQRT(DOT_PRODUCT(Q64(:,JG),Q64(:,JG)))
        IF(DEN.LE.0.0D0) CALL XABORT('AXMAT R64: ZERO SOURCE')
        RT64=SQRT(SUM((R64(:,JG)-X64(:,JG))**2))/DEN
        RT32=SQRT(SUM((RROUND(:,JG)-XROUND(:,JG))**2))/DEN
        RTBAD=SQRT(SUM((RNEG(:,JG)-XNEG(:,JG))**2))/DEN
        REPEAT=MAXVAL(ABS(R64(:,JG)-RREP(:,JG)))
        IF(RT64.GE.DBLE(ERRTOL)) NFAIL64=NFAIL64+1
        IF(RT32.GE.DBLE(ERRTOL)) NFAIL32=NFAIL32+1
        IF(RTBAD.GE.DBLE(ERRTOL)) NBAD=NBAD+1
        WRITE(6,320) NGIND(JG),EPS64(JG),RT64,RT32,RTBAD,
     1   REPEAT,DEN
        DO JF=1,NUN
          WRITE(6,330) NGIND(JG),JF,Q64(JF,JG),X64(JF,JG),
     1     R64(JF,JG),RREP(JF,JG),XROUND(JF,JG),
     2     RROUND(JF,JG),XNEG(JF,JG),RNEG(JF,JG)
        ENDDO
      ENDDO
      IF(NFAIL64.NE.0.OR.NBAD.NE.NGEFF)
     1 CALL XABORT('AXMAT R64: POSITIVE/NEGATIVE CHECK FAILED')
      IF(ANY(R64.NE.RREP)) CALL XABORT('AXMAT R64: NONREPEATABLE')
* Separate two-Arnoldi-work negative control, never the accepted solver.
      XROUND=XINIT
      ACAP=.TRUE.
      NCAP=NGEFF
      HCAP=0.0D0
      ECAP=0.0D0
      S64=0.0D0
      CALL MCGMRE64_CAP(KPSYS,IPTRK,IFTRAK,0,NGEFF,NGIND,NUN,
     1 NREG,M,NLONG,NBTR0,NMAX,NMU,NANGL,NBATCH,LC,MST(17),
     2 PACA,MATALB,KEYFLX,KEYCUR,NZON,VOL,CAZ1,CAZ2,CPO,ZMU,
     3 WZMU,SC32,SIGAL,LEAK64,Q64,XROUND,S64,RROUND,
     4 DBLE(ERRTOL),HCAP,ECAP,ITCAP,ACAP,NCAP,CUTOFF,OKCAP)
      IF(OKCAP.OR.NCAP.EQ.0)
     1 CALL XABORT('AXMAT R64: CAP WAS FALSELY ACCEPTED')
      WRITE(6,340) NFAIL64,NFAIL32,NBAD,NCAP
      WRITE(6,'(A)') 'AXMAT-R64-FIRST-CALL-PROBE-COMPLETE'
      FLUSH(6)
      STOP 0
  320 FORMAT('AXMAT-R64 GROUP=',I4,1P,6E24.16)
  330 FORMAT('AXMAT-R64-VECTOR ',2I5,1P,8E24.16)
  340 FORMAT('AXMAT-R64-COUNTS FAIL64=',I4,' FAIL32=',I4,
     1 ' NEGATIVE-REJECTED=',I4,' CAP-UNRESOLVED=',I4)
      END
